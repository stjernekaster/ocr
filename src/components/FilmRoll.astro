---
const { billede, display, border } = Astro.props;
---

<section>
  <div class="top" style=`visibility:${display}; border-right:${border};`>
    <div class="dot"></div>
    <div class="dot" style="margin-left: 4.85%;"></div>
    <div class="dot" style="margin-left: 4.85%;"></div>
    <div class="dot" style="margin-left: 4.85%;"></div>
    <div class="dot" style="margin-left: 4.85%;"></div>
    <div class="dot" style="margin-left: 4.85%;"></div>
    <div class="dot" style="margin-left: 4.85%;"></div>
    <div class="dot" style="margin-left: 4.85%;"></div>
    <div class="dot" style="margin-left: 4.85%;"></div>
    <div class="dot" style="margin-left: 4.85%;"></div>
    <div class="dot" style="margin-left: 4.85%;"></div>
    <div class="dot" style="margin-left: 4.85%;"></div>
    <div class="dot" style="margin-left: 4.85%;"></div>
    <div class="dot" style="margin-left: 4.85%;"></div>
  </div>
  <img src={billede} alt="" />
  <div class="bottom">
    <div class="dot"></div>
    <div class="dot" style="margin-left: 4.85%;"></div>
    <div class="dot" style="margin-left: 4.85%;"></div>
    <div class="dot" style="margin-left: 4.85%;"></div>
    <div class="dot" style="margin-left: 4.85%;"></div>
    <div class="dot" style="margin-left: 4.85%;"></div>
    <div class="dot" style="margin-left: 4.85%;"></div>
    <div class="dot" style="margin-left: 4.85%;"></div>
    <div class="dot" style="margin-left: 4.85%;"></div>
    <div class="dot" style="margin-left: 4.85%;"></div>
    <div class="dot" style="margin-left: 4.85%;"></div>
    <div class="dot" style="margin-left: 4.85%;"></div>
    <div class="dot" style="margin-left: 4.85%;"></div>
    <div class="dot" style="margin-left: 4.85%;"></div>
  </div>
</section>

<style>
  section {
    width: 100%;
    height: auto;
    aspect-ratio: 4/3;
    position: relative;
    border-left: 5px solid black;
  }

  .top,
  .bottom {
    background-color: black;
    height: 10%;
    display: flex;
  }

  .bottom {
    bottom: 0;
    width: 100%;
  }

  .dot {
    background-color: white;
    aspect-ratio: 1/1;
    width: 1.3vh;
    height: auto;
    align-self: center;
    margin-left: 2%;
  }

  img {
    aspect-ratio: 4/3;
    object-fit: cover;
    width: 100%;
    transition: 0.3s;
  }

  img:hover {
    opacity: 0.8;
    transition: 0.3s;
  }
</style>
